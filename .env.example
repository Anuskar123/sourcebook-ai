# Copy to .env. Generate each secret independently, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONGO_PASSWORD=replace-with-random-hex
NEO4J_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
ML_API_TOKEN=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Exact trusted public hostnames only, comma separated. Redirects are refused.
SCRAPE_ALLOWED_HOSTS=example.com
WEB_ORIGIN=http://localhost:5173
# Host process overrides. Compose supplies its own service DNS addresses.
MONGO_HOST_PORT=27018
MONGODB_URI=mongodb://root:replace-with-random-hex@127.0.0.1:27018/portfolio?authSource=admin
MONGODB_DB=portfolio
CHROMA_URL=http://127.0.0.1:8000
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
API_URL=http://127.0.0.1:3000
ML_API_URL=http://127.0.0.1:8001
